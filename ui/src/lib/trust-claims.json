            "crates/juggler-app/src/crash_native.rs::links_and_oversized_files_are_not_read"
          ]
        },
        {
          "id": "other-managers",
          "text": "If you use Claude Squad or Vibe Kanban, it reads their own lists for which repository each of their worktrees belongs to and which config folders their profiles use, and nothing else they keep. It never opens their sign-in or key files.",
          "tests": [
            "crates/juggler-adapters/tests/other_managers.rs::claude_squad_worktrees_come_with_their_repositories",
