            "crates/juggler-stats/src/tests.rs::off_creates_no_folder_and_records_nothing",
            "crates/juggler-app/tests/trust.rs::the_app_reaches_only_its_own_addresses"
          ]
        },
        {
          "id": "crash-reports",
          "text": "Crash reports are kept on your Mac, with names and paths taken out. This version has nowhere to send them.",
          "tests": [
