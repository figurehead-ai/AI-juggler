{
  "$comment": "AI Juggler usage statistics, schema 1 (docs/USAGE-STATS-SPEC.md \u00a76\u2013\u00a77). Closed: the server rejects any metric, dimension or value not listed here. Enums may still grow until the first AI Juggler release that uploads; after that, changes need a new schema version. Every dimension listed for a metric is required; conditional dimensions use \"none\". Counters and histograms are capped per report by \"max\" (default: limits.counter_max / limits.histogram_total_max); reports over a cap are rejected.",
  "schema": 1,
  "limits": {
    "counter_max": 10000,
    "histogram_total_max": 10000
  },
  "enums": {
    "provider": [
      "claude-code",
      "codex",
      "zcode",
      "other"
    ],
    "count_bucket": [
      "0",
      "1",
      "2",
      "3",
      "4-5",
      "6-9",
      "10+"
    ],
    "switch_kind": [
      "account",
      "provider",
      "instance"
    ],
    "switch_trigger": [
      "quota_wall",
      "suggestion",
      "manual",
      "remote"
    ],
    "model_family": [
      "opus",
      "sonnet",
      "haiku",
      "gpt-5",
      "gpt-5-codex",
      "gpt-5-mini",
      "glm-4",
      "glm-5",
      "other"
    ],
    "leftover_category": [
      "dev_server",
      "mcp",
      "browser",
      "watcher",
      "other"
    ],
    "error_area": [
      "adapter",
      "supervisor",
      "storage",
      "switch",
      "fleet",
      "updater",
      "ui"
    ],
    "error_code": [
      "parse_failed",
      "io_error",
      "permission_denied",
      "timeout",
      "not_found",
      "version_unsupported",
      "db_locked",
      "db_corrupt",
      "network",
      "signature_invalid",
      "spawn_failed",
      "pty_failed",
      "invalid_state",
      "other"
    ]
  },
  "metrics": {
