      "dims": {
        "provider": "provider"
      },
      "pattern": "^(\\d{1,4}\\.\\d{1,4}|other)$"
    },
    "launch_settings.count": {
      "type": "gauge",
      "dims": {
        "provider": "provider"
      },
      "values": "count_bucket"
    },
    "projects.count": {
