#!/usr/bin/env bash
# A push to main or release/* only of a commit `scripts/preflight.sh`
# passed (#198): its fast mode (the default, ADR-0025), `--light` or
# `--full`. Each stamps the commit; GitHub then runs every gate on the pull
# request, the release candidate's build (rc-dev-app) included.
# Other branches push freely. Installed by `just hooks` (core.hooksPath).
# In an emergency, AIJ_PREFLIGHT_SKIP="the reason" lets one push through
# and says so; the release PR's CI still runs.
# D-101: on every branch, no outgoing commit's added lines, paths or
# message hold a denylisted real name (private_terms.py; README.md here).
set -uo pipefail
STAMPS="$(git rev-parse --git-common-dir)/aij-preflight"
status=0
REFS="$(cat)"
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ -n "$local_sha" ] || continue
  python3 "$(git rev-parse --show-toplevel)/scripts/hooks/private_terms.py" push "$remote_sha" "$local_sha" || status=1
done <<<"$REFS"
while read -r local_ref local_sha remote_ref _remote_sha; do
  [ -n "$local_sha" ] || continue
  case "$remote_ref" in
    refs/heads/main | refs/heads/release/*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = 0000000000000000000000000000000000000000 ] && continue # a delete
  if [ -f "$STAMPS/$local_sha" ]; then
    continue
  fi
  if [ -n "${AIJ_PREFLIGHT_SKIP:-}" ]; then
    echo "pre-push: ${local_sha:0:12} to ${remote_ref#refs/heads/} WITHOUT preflight: $AIJ_PREFLIGHT_SKIP" >&2
    continue
  fi
  echo "pre-push: ${local_sha:0:12} (${local_ref#refs/heads/}) hasn't passed preflight; run \`just preflight-light\` (or \`just preflight\`) on this commit (a few minutes, low load) before pushing to ${remote_ref#refs/heads/}." >&2
  status=1
done <<<"$REFS"
exit $status
