{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/juggler-mcp\" hook SessionStart --connector",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/juggler-mcp\" hook UserPromptSubmit --connector",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
