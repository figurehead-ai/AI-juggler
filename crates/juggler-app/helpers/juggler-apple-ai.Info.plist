<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in the helper's __TEXT,__info_plist (scripts/build_apple_ai_helper.sh).
     The identifier is the build's identity's (AJ-E3822,
     scripts/helper_identity.sh: <prefix>.apple-ai, written in place of
     @HELPER_IDENTIFIER@): what it is signed as (codesign reads it from
     here) and what the app requires (engines/apple.rs identifier()); the
     App Sandbox gives the helper its container by it. The names are what
     a system prompt shows for it (never "(null)"). -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>@HELPER_IDENTIFIER@</string>
    <key>CFBundleName</key>
    <string>AI Juggler</string>
    <key>CFBundleDisplayName</key>
    <string>AI Juggler</string>
</dict>
</plist>
