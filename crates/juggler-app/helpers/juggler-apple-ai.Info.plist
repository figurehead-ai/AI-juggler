<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Embedded in the helper's __TEXT,__info_plist (scripts/build_apple_ai_helper.sh).
     The identifier is what it is signed as (codesign reads it from here) and
     what the app requires (engines/apple.rs IDENTIFIER); the App Sandbox
     needs it to give the helper its container. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>ai.figurehead.juggler.apple-ai</string>
    <key>CFBundleName</key>
    <string>juggler-apple-ai</string>
</dict>
</plist>
