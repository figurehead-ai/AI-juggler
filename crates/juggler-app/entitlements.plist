<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Jump to a session's window drives System Events (focus.rs). The
         hardened runtime denies Apple Events without this, with no prompt;
         the usage text is NSAppleEventsUsageDescription in Info.plist. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
